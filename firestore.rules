rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow users to read/write their own user profile, follow functionality, etc.
    // (Assuming existing rules allow read/write to users and trips, keeping them open or basic for now)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow others to update following/followers array
      allow update: if request.auth != null; 
    }
    
    match /trips/{tripId} {
      allow read: if !("visibility" in resource.data) 
        || resource.data.visibility == 'public' 
        || resource.data.visibility == 'followers'
        || resource.data.creatorId == request.auth.uid
        || (request.auth != null && exists(/databases/$(database)/documents/tripMembers/$(tripId + '_' + request.auth.uid)))
        || (request.auth != null && exists(/databases/$(database)/documents/tripInvitations/$(tripId + '_' + request.auth.uid)));
      
      // 1. Create: Must be authenticated and must set themselves as the creator
      allow create: if request.auth != null && request.auth.uid == request.resource.data.creatorId;
      
      // 2. Delete: Only the creator can delete the trip
      allow delete: if request.auth != null && request.auth.uid == resource.data.creatorId;
      
      // 3. Update: Only creator can update
      allow update: if request.auth != null && request.auth.uid == resource.data.creatorId;
    }

    function getTrip(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data;
    }
    function hasAcceptedInvite(tripId, userId) {
      let invDoc = /databases/$(database)/documents/tripInvitations/$(tripId + '_' + userId);
      return existsAfter(invDoc) && getAfter(invDoc).data.status == 'accepted';
    }

    match /tripMembers/{memberId} {
      allow read: if !("visibility" in getTrip(resource.data.tripId))
        || getTrip(resource.data.tripId).visibility == 'public'
        || getTrip(resource.data.tripId).visibility == 'followers'
        || getTrip(resource.data.tripId).creatorId == request.auth.uid
        || (request.auth != null && exists(/databases/$(database)/documents/tripMembers/$(resource.data.tripId + '_' + request.auth.uid)));
        
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId
        && (
          getTrip(request.resource.data.tripId).creatorId == request.auth.uid 
          || !("visibility" in getTrip(request.resource.data.tripId))
          || getTrip(request.resource.data.tripId).visibility != 'invite'
          || hasAcceptedInvite(request.resource.data.tripId, request.auth.uid)
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /tripInvitations/{invitationId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.receiverId || request.auth.uid == resource.data.senderId);
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.senderId
        && getTrip(request.resource.data.tripId).creatorId == request.auth.uid; // Only creator can invite
      allow update: if request.auth != null 
        && (
          // Receiver can accept/decline
          (request.auth.uid == resource.data.receiverId && (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          ||
          // Sender can cancel
          (request.auth.uid == resource.data.senderId && request.resource.data.status == 'cancelled' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        );
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.receiverId;
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.senderId
        && (
          request.resource.data.type != 'trip_invitation' || 
          (
            getTrip(request.resource.data.tripId).creatorId == request.auth.uid
            && existsAfter(/databases/$(database)/documents/tripInvitations/$(request.resource.data.tripId + '_' + request.resource.data.receiverId))
          )
        );
      allow update: if request.auth != null && request.auth.uid == resource.data.receiverId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // --- CHAT FEATURE RULES ---
    match /chats/{chatId} {
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.participantIds);
      
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participantIds;
      
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.participantIds ||
        (
          // User is adding themselves
          request.resource.data.participantIds.hasAll(resource.data.participantIds) &&
          request.resource.data.participantIds.size() == resource.data.participantIds.size() + 1 &&
          request.auth.uid in request.resource.data.participantIds &&
          // Check if it's a trip chat
          (
            resource.data.tripId == null || 
            hasAcceptedInvite(resource.data.tripId, request.auth.uid) ||
            getTrip(resource.data.tripId).creatorId == request.auth.uid
          )
        )
      );
      
      allow delete: if request.auth != null && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        // Inherit permissions from parent room security layout
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }
  }
}
